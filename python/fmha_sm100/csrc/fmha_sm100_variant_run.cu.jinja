using tvm::ffi::Optional;

// Forward-declare the variant kernel function (defined in the inst .cu file)
extern cudaError_t {{ func_name }}(const FMHACutlassSM100Params& p);

void FMHAVariantRun_{{ variant_name }}(ffi::TensorView workspace_buffer, ffi::TensorView q, ffi::TensorView k,
                    ffi::TensorView v, ffi::TensorView qo_segment_lens,
                    ffi::TensorView kv_segment_lens,
                    ffi::TensorView qo_segment_offsets,
                    ffi::TensorView kv_segment_offsets,
                    ffi::TensorView packed_work_range,
                    ffi::TensorView packed_work_info,
                    Optional<ffi::TensorView> maybe_o,
                    double sm_scale, double scale_q, double scale_k, double scale_v,
                    double o_scale, int64_t max_qo_len,
                    Optional<ffi::TensorView> maybe_qo_offsets,
                    int64_t num_kv_splits,
                    Optional<ffi::TensorView> maybe_kv_tile_begin_indices,
                    Optional<ffi::TensorView> maybe_kv_tile_end_indices,
                    Optional<ffi::TensorView> maybe_kv_split_indices,
                    Optional<ffi::TensorView> maybe_workspace_o,
                    Optional<ffi::TensorView> maybe_workspace_lse,
                    Optional<ffi::TensorView> maybe_num_kv_splits_per_row,
                    int64_t qo_tile_size,
                    Optional<ffi::TensorView> maybe_kv_indices,
                    Optional<ffi::TensorView> maybe_kv_page_indptr,
                    Optional<ffi::TensorView> maybe_max_score,
                    int64_t max_k_tiles,
                    Optional<ffi::TensorView> maybe_kv_block_indexes,
                    int64_t pack_factor,
                    bool qo_len_uniform,
                    int64_t stream_ptr
{% if kv_mode >= 3 %}
                    ,
                    Optional<ffi::TensorView> maybe_nvfp4_k_data,
                    Optional<ffi::TensorView> maybe_nvfp4_k_scale,
                    Optional<ffi::TensorView> maybe_nvfp4_v_data,
                    Optional<ffi::TensorView> maybe_nvfp4_v_scale,
                    int64_t nvfp4_page_stride,
                    int64_t nvfp4_head_stride_data,
                    int64_t nvfp4_head_stride_scale,
                    double dequant_g_k,
                    double dequant_g_v,
                    ffi::TensorView nvfp4_k_global_scale,
                    ffi::TensorView nvfp4_v_global_scale
{% endif %}
{% if sparse_mode == "OnlyScoreIcp" %}
                    ,
                    Optional<ffi::TensorView> maybe_valid_score,
                    Optional<ffi::TensorView> maybe_icp_block_table,
                    int64_t icp_block_table_row_stride,
                    int64_t icp_block_table_row_begin
{% endif %}
                    ) {
  bool is_paged = maybe_kv_indices.has_value();
{% if sparse_mode == "OnlyScoreIcp" %}
  is_paged = is_paged || maybe_icp_block_table.has_value();
{% endif %}
  int head_dim_qk = q.size(2);
  int head_dim_vo = {{ "128" if kv_mode >= 3 else "is_paged ? v.size(3) : v.size(2)" }};
  int num_qo_heads = q.size(1);
  int num_kv_heads = k.size(1);
  int page_size = is_paged ? k.size(2) : 0;

  void* o_ptr = maybe_o.has_value() ? maybe_o.value().data_ptr() : nullptr;
  float* max_score_ptr = maybe_max_score.has_value()
                             ? static_cast<float*>(maybe_max_score.value().data_ptr())
                             : nullptr;
  int* kv_block_indexes_ptr = maybe_kv_block_indexes.has_value()
                                  ? static_cast<int*>(maybe_kv_block_indexes.value().data_ptr())
                                  : nullptr;

  const cudaStream_t stream = reinterpret_cast<cudaStream_t>(stream_ptr);

  FMHACutlassSM100Params params;
  params.workspace_buffer_ptr = workspace_buffer.data_ptr();
  params.q_ptr = q.data_ptr();
  params.k_ptr = k.data_ptr();
  params.v_ptr = v.data_ptr();
  params.qo_segment_lens_ptr = static_cast<int*>(qo_segment_lens.data_ptr());
  params.kv_segment_lens_ptr = static_cast<int*>(kv_segment_lens.data_ptr());
  params.qo_segment_offsets_ptr = static_cast<int*>(qo_segment_offsets.data_ptr());
  params.kv_segment_offsets_ptr = static_cast<int*>(kv_segment_offsets.data_ptr());
  params.packed_work_range_ptr = static_cast<uint64_t*>(packed_work_range.data_ptr());
  params.packed_work_info_ptr = static_cast<uint64_t*>(packed_work_info.data_ptr());
  params.o_ptr = o_ptr;
  params.mask_mode_code = 1;  // causal only
  params.sm_scale = sm_scale;
  params.scale_q = scale_q;
  params.scale_k = scale_k;
  params.scale_v = scale_v;
  params.o_scale = o_scale;
  params.num_qo_heads = num_qo_heads;
  params.num_kv_heads = num_kv_heads;
  params.head_dim_qk = head_dim_qk;
  params.head_dim_vo = head_dim_vo;
  params.q_stride_n = q.stride(0);
  params.q_stride_h = q.stride(1);
  params.k_stride_n = k.stride(0);
  params.k_stride_h = k.stride(1);
  params.k_stride_t = is_paged ? k.stride(2) : k.stride(0);
  params.v_stride_n = v.stride(0);
  params.v_stride_h = v.stride(1);
  params.v_stride_t = is_paged ? v.stride(2) : v.stride(0);
  params.batch_size = qo_segment_lens.size(0);
  params.total_qo_len = q.size(0);
  params.total_kv_len = is_paged ? 0 : k.size(0);
  params.max_qo_len = static_cast<int>(max_qo_len);
  params.qo_offsets_ptr = maybe_qo_offsets.has_value()
                              ? static_cast<int*>(maybe_qo_offsets.value().data_ptr())
                              : nullptr;
  params.stream = stream;
  params.num_kv_splits = static_cast<int>(num_kv_splits);
  params.kv_tile_begin_ptr = maybe_kv_tile_begin_indices.has_value()
                                 ? static_cast<int*>(maybe_kv_tile_begin_indices.value().data_ptr())
                                 : nullptr;
  params.kv_tile_end_ptr = maybe_kv_tile_end_indices.has_value()
                               ? static_cast<int*>(maybe_kv_tile_end_indices.value().data_ptr())
                               : nullptr;
  params.kv_split_ptr = maybe_kv_split_indices.has_value()
                            ? static_cast<int*>(maybe_kv_split_indices.value().data_ptr())
                            : nullptr;
  params.workspace_o_ptr = maybe_workspace_o.has_value()
                               ? maybe_workspace_o.value().data_ptr()
                               : nullptr;
  params.workspace_lse_ptr = maybe_workspace_lse.has_value()
                                     ? static_cast<float*>(maybe_workspace_lse.value().data_ptr())
                                     : nullptr;
  params.num_kv_splits_per_row_ptr = maybe_num_kv_splits_per_row.has_value()
                                         ? static_cast<int*>(maybe_num_kv_splits_per_row.value().data_ptr())
                                         : nullptr;
  params.kv_indices_ptr = maybe_kv_indices.has_value()
                              ? static_cast<int*>(maybe_kv_indices.value().data_ptr())
                              : nullptr;
  params.kv_page_indptr_ptr = maybe_kv_page_indptr.has_value()
                                  ? static_cast<int*>(maybe_kv_page_indptr.value().data_ptr())
                                  : nullptr;
  params.total_page_num = is_paged ? k.size(0) : 0;
  params.max_score_ptr = max_score_ptr;
  params.max_k_tiles = static_cast<int>(max_k_tiles);
  int max_score_logical_heads = 0;
  if (maybe_max_score.has_value()) {
    const auto& ms = maybe_max_score.value();
    TVM_FFI_ICHECK(ms.ndim() == 3) << "max_score must be 3D";
    TVM_FFI_ICHECK(encode_dlpack_dtype(ms.dtype()) == float32_code)
        << "max_score must be float32";

    const int64_t ms0 = ms.size(0);
    const int64_t ms1 = ms.size(1);
    const int64_t ms2 = ms.size(2);
    const int64_t max_k = max_k_tiles;
    const int64_t unpacked_t = q.size(0);
    const int64_t unpacked_h = q.size(1);
    const int64_t packed_t = q.size(0) * static_cast<int64_t>(pack_factor);
    const int64_t packed_h = q.size(1) / static_cast<int64_t>(pack_factor);

    const bool thk_unpacked = (ms0 == unpacked_t && ms1 == unpacked_h && ms2 == max_k);
    const bool hkt_unpacked = (ms0 == unpacked_h && ms1 == max_k && ms2 == unpacked_t);
    const bool thk_packed = (ms0 == packed_t && ms1 == packed_h && ms2 == max_k);
    const bool hkt_packed = (ms0 == packed_h && ms1 == max_k && ms2 == packed_t);

    if (thk_unpacked) {
      params.max_score_stride_t = static_cast<int>(ms.stride(0));
      params.max_score_stride_h = static_cast<int>(ms.stride(1));
      params.max_score_stride_k = static_cast<int>(ms.stride(2));
      params.total_qo_len_orig = static_cast<int>(unpacked_t);
      max_score_logical_heads = static_cast<int>(unpacked_h);
    } else if (hkt_unpacked) {
      params.max_score_stride_t = static_cast<int>(ms.stride(2));
      params.max_score_stride_h = static_cast<int>(ms.stride(0));
      params.max_score_stride_k = static_cast<int>(ms.stride(1));
      params.total_qo_len_orig = static_cast<int>(unpacked_t);
      max_score_logical_heads = static_cast<int>(unpacked_h);
    } else if (thk_packed) {
      params.max_score_stride_t = static_cast<int>(ms.stride(0));
      params.max_score_stride_h = static_cast<int>(ms.stride(1));
      params.max_score_stride_k = static_cast<int>(ms.stride(2));
      params.total_qo_len_orig = static_cast<int>(packed_t);
      max_score_logical_heads = static_cast<int>(packed_h);
    } else if (hkt_packed) {
      params.max_score_stride_t = static_cast<int>(ms.stride(2));
      params.max_score_stride_h = static_cast<int>(ms.stride(0));
      params.max_score_stride_k = static_cast<int>(ms.stride(1));
      params.total_qo_len_orig = static_cast<int>(packed_t);
      max_score_logical_heads = static_cast<int>(packed_h);
    } else {
      TVM_FFI_ICHECK(false)
          << "max_score must have shape [T,H,K] or [H,K,T]; got ["
          << ms0 << ", " << ms1 << ", " << ms2 << "], expected unpacked ["
          << unpacked_t << ", " << unpacked_h << ", " << max_k << "] or ["
          << unpacked_h << ", " << max_k << ", " << unpacked_t << "]";
    }
  }
  params.kv_block_indexes_ptr = kv_block_indexes_ptr;
  params.kv_block_num = maybe_kv_block_indexes.has_value()
                            ? static_cast<int>(maybe_kv_block_indexes.value().size(2))
                            : 0;

{% if sparse_mode == "OnlyScoreIcp" %}
  // ---- refined-icp-v1: the direct compound-page table ------------------------------
  // Checked, not trusted.  Every condition below is one whose silent alternative is a
  // read of the WRONG PAGE that still lands inside the cache and still returns finite
  // numbers, which is the failure signature this whole redesign trades into
  // (DIRECT_TABLE_CONTRACT §C / I-1).  None of these touches device memory.
  params.icp_block_table_ptr = nullptr;
  params.icp_block_table_row_stride = 0;
  params.icp_block_table_row_begin = 0;
  if (maybe_icp_block_table.has_value()) {
    const auto& bt = maybe_icp_block_table.value();
    TVM_FFI_ICHECK(encode_dlpack_dtype(bt.dtype()) == int32_code)
        << "icp_block_table must be int32";
    TVM_FFI_ICHECK(bt.ndim() == 2)
        << "icp_block_table must be 2D [num_requests, max_blocks_per_req]; got ndim="
        << bt.ndim();
    TVM_FFI_ICHECK(icp_block_table_row_stride > 0)
        << "icp_block_table_row_stride must be positive; it is the row address pitch";
    // The pitch is an ADDRESS pitch, so it must be the tensor's real row stride.  A
    // caller that passed the logical column count of a padded table would address every
    // row but the first at the wrong offset -- in bounds, wrong tenant.
    TVM_FFI_ICHECK(bt.stride(0) == icp_block_table_row_stride)
        << "icp_block_table row stride " << icp_block_table_row_stride
        << " != tensor stride(0) " << bt.stride(0);
    TVM_FFI_ICHECK(bt.stride(1) == 1)
        << "icp_block_table must be row-contiguous (stride(1) == 1); got " << bt.stride(1);
    // The rows this call actually addresses are
    // [row_begin, row_begin + batch_size), and they must all exist.  A short table
    // does not fault -- the row it lands on is another request's, or another chunk's.
    TVM_FFI_ICHECK(icp_block_table_row_begin >= 0)
        << "icp_block_table_row_begin must be non-negative; got "
        << icp_block_table_row_begin;
    TVM_FFI_ICHECK(icp_block_table_row_begin + params.batch_size <= bt.size(0))
        << "icp_block_table rows [" << icp_block_table_row_begin << ", "
        << (icp_block_table_row_begin + params.batch_size) << ") do not fit a table of "
        << bt.size(0) << " rows";
    params.icp_block_table_ptr = static_cast<int*>(bt.data_ptr());
    params.icp_block_table_row_stride = static_cast<int>(icp_block_table_row_stride);
    params.icp_block_table_row_begin = static_cast<int>(icp_block_table_row_begin);
  } else {
    TVM_FFI_ICHECK(icp_block_table_row_begin == 0)
        << "icp_block_table_row_begin was given without icp_block_table";
  }
{% if sparse_mode == "OnlyScoreIcp" %}
  // The direct table replaces the packed list, but `kv_indices` is ALSO how
  // `_fmha_sm100` decides a call is paged, so the caller passes the SAME TENSOR as both
  // and they cannot diverge.  What is refused is two DIFFERENT page directories in one
  // call, which would leave "which one did the loader use" a property of a pointer test
  // rather than of the call.  The buffer identity is the check, not the presence.
  if (maybe_icp_block_table.has_value() && maybe_kv_indices.has_value()) {
    TVM_FFI_ICHECK(maybe_kv_indices.value().data_ptr()
                   == maybe_icp_block_table.value().data_ptr())
        << "SparseAttnMode::OnlyScoreIcp received a packed page list AND a different "
           "direct compound-page table; pass the table as both, or the packed list "
           "alone";
    // A packed list comes with an indptr; the direct table must not.  This is the one
    // that actually separates the two modes.
    TVM_FFI_ICHECK(!maybe_kv_page_indptr.has_value())
        << "a direct-table call must not carry kv_page_indptr: the row origin/pitch and "
           "the device KV lengths replace the CSR entirely";
  }
  if (maybe_icp_block_table.has_value()) {
    // R == KVPageSize is not visible in this translation unit as a template parameter,
    // but it IS visible as the paged tensor's mode-0 extent, which is what the kernel's
    // `icp_local_blocks_exact` uses as R.  R * W == 128 is the ownership layout the
    // consumer's fused producer implements under the ICP producer-plan ABI;
    // W arrives packed in kv_block_num, so check the product here, on the host, where a
    // mismatch is a message instead of a silently shifted fragment bound.
    const int icp_w = params.kv_block_num & 15;
    TVM_FFI_ICHECK(icp_w >= 2 && page_size * icp_w == 128)
        << "direct-table ICP needs page_size * W == 128 (ABI G13/P3); got page_size="
        << page_size << " W=" << icp_w;
    TVM_FFI_ICHECK((params.kv_block_num >> 4) < icp_w)
        << "icp_rank " << (params.kv_block_num >> 4) << " is outside [0, " << icp_w << ")";
  }
{% else %}
  TVM_FFI_ICHECK(!maybe_icp_block_table.has_value())
      << "the direct compound-page table is a SparseAttnMode::OnlyScoreIcp input; "
         "variant {{ variant_name }} would accept the pointer and never read it";
{% endif %}

{% endif %}
  params.pack_factor = static_cast<int>(pack_factor);
  params.num_ctas = static_cast<int>(packed_work_range.size(0));

{% if kv_mode >= 3 %}
  auto nvfp4_u8_ptr = [](const Optional<ffi::TensorView>& t, const char* name) -> void* {
    if (!t.has_value()) return nullptr;
    TVM_FFI_ICHECK(encode_dlpack_dtype(t.value().dtype()) == uint8_code)
        << name << " must be uint8";
    return t.value().data_ptr();
  };
  params.nvfp4_k_data_ptr  = nvfp4_u8_ptr(maybe_nvfp4_k_data,  "nvfp4_k_data");
  params.nvfp4_k_scale_ptr = nvfp4_u8_ptr(maybe_nvfp4_k_scale, "nvfp4_k_scale");
  params.nvfp4_v_data_ptr  = nvfp4_u8_ptr(maybe_nvfp4_v_data,  "nvfp4_v_data");
  params.nvfp4_v_scale_ptr = nvfp4_u8_ptr(maybe_nvfp4_v_scale, "nvfp4_v_scale");
  params.nvfp4_page_stride       = nvfp4_page_stride;
  params.nvfp4_head_stride_data  = static_cast<int>(nvfp4_head_stride_data);
  params.nvfp4_head_stride_scale = static_cast<int>(nvfp4_head_stride_scale);
  params.dequant_g_k = static_cast<float>(dequant_g_k);
  params.dequant_g_v = static_cast<float>(dequant_g_v);
  params.nvfp4_k_global_scale = static_cast<const float*>(nvfp4_k_global_scale.data_ptr());
  params.nvfp4_v_global_scale = static_cast<const float*>(nvfp4_v_global_scale.data_ptr());
#if MSA_NVFP4_KV_MODE >= 3
  TVM_FFI_ICHECK(params.nvfp4_k_data_ptr && params.nvfp4_k_scale_ptr &&
                 params.nvfp4_v_data_ptr && params.nvfp4_v_scale_ptr)
      << "MSA_NVFP4_KV_MODE=3 variant {{ variant_name }} requires all four NVFP4 KV views";
  TVM_FFI_ICHECK(params.nvfp4_page_stride > 0)
      << "MSA_NVFP4_KV_MODE=3 requires a positive nvfp4_page_stride";
  TVM_FFI_ICHECK(params.dequant_g_k > 0.0f && params.dequant_g_v > 0.0f)
      << "dequant_g_k / dequant_g_v must be positive; got "
      << params.dequant_g_k << " / " << params.dequant_g_v;
#endif
{% endif %}
  if (pack_factor > 1) {
    params.q_stride_n_original = q.stride(0);
    params.q_stride_h_original = q.stride(1);
    params.h_r_original = num_qo_heads / num_kv_heads;
    int packed_num_qo_heads = num_qo_heads / static_cast<int>(pack_factor);
    params.num_qo_heads = packed_num_qo_heads;
    params.total_qo_len = q.size(0) * static_cast<int>(pack_factor);
    params.q_stride_n = packed_num_qo_heads * head_dim_qk;
    params.q_stride_h = head_dim_qk;

    // Pack GQA: direct max_score unpack
    // Activate when max_score is in unpacked shape (size(0) > packed num_qo_heads).
    if (maybe_max_score.has_value()
        && max_score_logical_heads > packed_num_qo_heads) {
      params.max_score_direct_ptr = max_score_ptr;
    }

    // Pack GQA: direct O unpack
    // Activated only when caller explicitly opts in (via Python flag) AND O is in unpacked shape.
    // Caller-allocated unpacked-shape O without opt-in (e.g. legacy bench) MUST go through
    // the original packed-write + Python _unpack_gqa_o path to keep semantics correct.
    if (pack_factor > 1
        && maybe_o.has_value()
        && static_cast<int>(maybe_o.value().size(1)) > packed_num_qo_heads) {
      params.o_direct_ptr = o_ptr;
      params.num_qo_heads_orig = static_cast<int>(maybe_o.value().size(1));
      params.o_ptr = nullptr;  // skip TMA descriptor for O

      // TMA fused direct-O unpack eligibility:
      //   1. qo_len uniform across batches (per-CTA tile shape constant)
      //   2. FMHA_DISABLE_TMA_DIRECT_O env var not set (A/B testing knob)
      // If ineligible, epilogue falls back to vec16 software scatter loop.
      static const bool tma_direct_o_disabled =
          (std::getenv("FMHA_DISABLE_TMA_DIRECT_O") != nullptr);
      params.tma_direct_o_enabled = qo_len_uniform && !tma_direct_o_disabled
                                    && (params.max_qo_len > 0);
      // total_qo_len_orig: unpacked tensor's leading dim
      // (already set if max_score present; ensure consistent if not)
      if (params.total_qo_len_orig == 0) {
        params.total_qo_len_orig =
            static_cast<int>(maybe_o.value().size(0));
      }
    }
  }

#ifdef FMHA_GMEM_BOUNDS_CHECK
  params.gmem_bounds.packed_work_range_size = static_cast<int>(packed_work_range.size(0));
  params.gmem_bounds.packed_work_info_size = static_cast<int>(packed_work_info.size(0));
  params.gmem_bounds.qo_segment_offsets_size = static_cast<int>(qo_segment_offsets.size(0));
  params.gmem_bounds.kv_segment_offsets_size = static_cast<int>(kv_segment_offsets.size(0));
  params.gmem_bounds.segment_lens_size = static_cast<int>(qo_segment_lens.size(0));
  params.gmem_bounds.kv_page_indptr_size = maybe_kv_page_indptr.has_value()
      ? static_cast<int>(maybe_kv_page_indptr.value().size(0)) : 0;
{% if sparse_mode == "OnlyScoreIcp" %}
  // `size(0)` is the element count for a flat packed list but the ROW count for the
  // rectangular direct table (which the caller passes as `kv_indices` too, so that
  // `_fmha_sm100` sees a paged call).  Use the real element count in that case, or the
  // bounds checker would report a false OOB on every row past the first.
  params.gmem_bounds.kv_indices_size = maybe_kv_indices.has_value()
      ? static_cast<int>(maybe_kv_indices.value().ndim() == 2
                             ? maybe_kv_indices.value().size(0)
                                   * maybe_kv_indices.value().stride(0)
                             : maybe_kv_indices.value().size(0)) : 0;
  // rows x row_stride, i.e. the WHOLE table.  It bounds walking off the table, not off a
  // row; a row overrun lands in the next request's row and is invisible here by
  // construction (that is what the device-derived live bound is for).
  params.gmem_bounds.icp_block_table_size = maybe_icp_block_table.has_value()
      ? static_cast<int>(maybe_icp_block_table.value().size(0)
                         * maybe_icp_block_table.value().stride(0)) : 0;
{% else %}
  params.gmem_bounds.kv_indices_size = maybe_kv_indices.has_value()
      ? static_cast<int>(maybe_kv_indices.value().size(0)) : 0;
{% endif %}
  params.gmem_bounds.max_score_numel = maybe_max_score.has_value()
      ? static_cast<int>(maybe_max_score.value().size(0)
                         * maybe_max_score.value().size(1)
                         * maybe_max_score.value().size(2)) : 0;
  params.gmem_bounds.kv_block_indexes_numel = maybe_kv_block_indexes.has_value()
      ? static_cast<int>(maybe_kv_block_indexes.value().size(0)
                         * maybe_kv_block_indexes.value().size(1)
                         * maybe_kv_block_indexes.value().size(2)) : 0;
  params.gmem_bounds.split_kv_size = maybe_kv_tile_begin_indices.has_value()
      ? static_cast<int>(maybe_kv_tile_begin_indices.value().size(0)) : 0;
  params.gmem_bounds.qo_offsets_size = maybe_qo_offsets.has_value()
      ? static_cast<int>(maybe_qo_offsets.value().size(0)) : 0;
#endif

{% if sparse_mode == "OnlyScoreIcp" %}
  // ---- refined-icp-v1: validity plane ----------------------------------------------
  // Checked, not trusted.  `-inf` is a LEGAL score (ABI W12), so a missing validity
  // plane cannot be detected downstream by inspecting values -- it has to fail HERE.
  params.valid_score_ptr = nullptr;
  if (maybe_valid_score.has_value()) {
    const auto& vs = maybe_valid_score.value();
    TVM_FFI_ICHECK(vs.ndim() == 3) << "valid_score must be 3D";
    TVM_FFI_ICHECK(encode_dlpack_dtype(vs.dtype()) == uint8_code)
        << "valid_score must be uint8 (ABI refined-icp-v1.abi.1 W4/W9)";
    TVM_FFI_ICHECK(maybe_max_score.has_value())
        << "valid_score without max_score is meaningless (ABI W4: the two planes are "
           "shape-matched)";
    const auto& ms = maybe_max_score.value();
    TVM_FFI_ICHECK(vs.size(0) == ms.size(0) && vs.size(1) == ms.size(1) &&
                   vs.size(2) == ms.size(2))
        << "valid_score must be shape-matched to max_score (ABI W4); got ["
        << vs.size(0) << ", " << vs.size(1) << ", " << vs.size(2) << "] vs ["
        << ms.size(0) << ", " << ms.size(1) << ", " << ms.size(2) << "]";
    params.valid_score_ptr = static_cast<uint8_t*>(vs.data_ptr());
    // The score plane's own (t,h,k) strides were resolved above from the SAME shape,
    // so resolving the validity strides by the same case analysis is unnecessary:
    // take them positionally from the shape-matched tensor.
    if (ms.size(0) == vs.size(0) && params.max_score_stride_t == static_cast<int>(ms.stride(0))) {
      params.valid_score_stride_t = static_cast<int>(vs.stride(0));
      params.valid_score_stride_h = static_cast<int>(vs.stride(1));
      params.valid_score_stride_k = static_cast<int>(vs.stride(2));
    } else {
      // [H,K,T] layout: max_score strides were taken as (2,0,1) -> (t,h,k).
      params.valid_score_stride_t = static_cast<int>(vs.stride(2));
      params.valid_score_stride_h = static_cast<int>(vs.stride(0));
      params.valid_score_stride_k = static_cast<int>(vs.stride(1));
    }
  }
  // ICP is the mode whose output ABI this plane versions.  sparse_mode 4
  // (`OnlyScoreIcp`) at output-ABI version 2 (`kIcpScoreAbiVersion`) REQUIRES it:
  // an unmigrated caller must fail loudly here rather than read an in-band -inf
  // as "empty".
{% if sparse_mode == "OnlyScoreIcp" %}
  TVM_FFI_ICHECK(params.valid_score_ptr != nullptr)
      << "SparseAttnMode::OnlyScoreIcp output ABI version "
      << FMHACutlassSM100Params::kIcpScoreAbiVersion
      << " (refined-icp-v1.abi.1 W4/W5) requires the out-of-band uint8 validity plane; "
         "the caller passed none.  ABI version 1 (in-band -inf) is SUPERSEDED: -inf is "
         "a legal representable score (W12) and cannot encode invalidity.";
{% endif %}

{% endif %}
  cudaError_t status = {{ func_name }}(params);
  TVM_FFI_ICHECK_EQ(status, cudaSuccess)
      << "FMHA variant {{ variant_name }} failed: " << cudaGetErrorString(status);
}

TVM_FFI_DLL_EXPORT_TYPED_FUNC(run_{{ variant_name }}, FMHAVariantRun_{{ variant_name }});
