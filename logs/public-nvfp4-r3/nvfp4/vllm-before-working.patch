+    monkeypatch.setattr(mrv2, "free_before_shutdown", lambda _: None)
+    runner.shutdown()
+    assert events[:2] == ["drain", "close_peer"]
+    assert events.count("close_peer") == 1
+    assert all(event == "release_cache" for event in events[2:])
+
