+    assert schedule_ref() is not None
+    shutdown_model_resources((models[0],))
+    assert first.impl.decode_plans is None
+    assert plans_ref() is second.impl.decode_plans
+    assert schedule_ref() is not None
+    shutdown_model_resources((models[1], models[1]))
