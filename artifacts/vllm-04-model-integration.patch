+                    select_decode_candidates,
+                    score_plane[:extent],
+                    geometry,
+                    plan=self.icp_decode_plans[extent],
+                    workspace=self.icp_decode_workspaces[extent],
+                    out=out,
+                    arm=self.icp_decode_arm,
+                )
