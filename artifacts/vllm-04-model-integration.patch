+        )
+        if decode_rows
+        else None
+    )
+    prefill = (
+        MiniMaxM3SparsePrefillMetadata(
+            cu_seqlens_q=torch.tensor([0, prefill_rows], dtype=torch.int32),
+            cu_seqlens_k=torch.tensor([0, 701], dtype=torch.int32),
+            seq_lens=seq_lens[1:],
